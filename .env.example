# Copy this file to .env and fill in your values
# .env is git-ignored and should NEVER be committed

SECRET_KEY=your_random_secret_key_here

# Database Configuration
# Local SQLite fallback (if DATABASE_URL is not set):
# sqlite:///resume_app.db
#
# Neon PostgreSQL (copy connection string from Neon dashboard):
# DATABASE_URL=postgresql://neondb_owner:npg_xxxxxx@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Stripe Keys (USD International Payments)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay Keys (INR Indian Payments)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Resend Email Configuration (API)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=onboarding@resend.dev

