# Copy this file to .env and fill in your values
# .env is git-ignored and should NEVER be committed

SECRET_KEY=your_random_secret_key_here

# For local PostgreSQL (optional — SQLite is used if not set):
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/resumebuilder

# For Render (set this in the Render dashboard as an environment variable):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Stripe keys
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Resend Email Configuration (API)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=onboarding@resend.dev

